file(READ "${CMAKE_CURRENT_LIST_DIR}/../VERSION" ARCHCODEX_VERSION)
string(STRIP "${ARCHCODEX_VERSION}" ARCHCODEX_VERSION)
if(NOT ARCHCODEX_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$")
  message(FATAL_ERROR "VERSION must be X.Y.Z or X.Y.Z-rc.N (N starts at 1)")
endif()
string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" ARCHCODEX_NUMERIC_VERSION "${ARCHCODEX_VERSION}")
string(TIMESTAMP ARCHCODEX_RELEASE_DATE "%Y-%m-%d" UTC)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../VERSION")

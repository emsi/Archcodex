+void Part::startProgramLiteral(const QString &program, const QStringList &arguments)
+{
+    Q_ASSERT(activeSession());
+    if (activeSession()->isRunning()) {
+        return;
+    }
+    activeSession()->setProgramLiteral(program, arguments);
+    activeSession()->run();
+}

+void Emulation::setEscapedLinks(bool enabled, const QStringList &allowedSchemes)
+{
+    for (Screen *screen : _screen) {
+        screen->setEnableUrlExtractor(enabled);
+        if (auto *extractor = screen->urlExtractor()) {
+            extractor->setAllowedLinkSchema(allowedSchemes);
+        }
+    }
